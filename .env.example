# Copy this file to ".env" and fill in the values (never commit .env).
# GMAIL_APP_PASSWORD is a Google "App password", not your normal Gmail password:
#   Google Account > Security > 2-Step Verification (turn on) > App passwords > create one.
GMAIL_USER=punay.jeric@gmail.com
GMAIL_APP_PASSWORD=
# Optional: deliver messages to a different inbox (defaults to GMAIL_USER)
# CONTACT_TO=punay.jeric@gmail.com

# Chatbot (api/chat.js) uses Vercel AI Gateway.
# On Vercel nothing is needed (it authenticates automatically). Locally, run `vercel env pull .env.local`
# to get a VERCEL_OIDC_TOKEN, or set an AI Gateway API key (required on Render):
# AI_GATEWAY_API_KEY=
# CHAT_MODEL=anthropic/claude-haiku-5.5

# Free, fast AI for the chatbot (recommended): https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# Optional free alternative: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
