# Copy this file to ".env" and fill in the values (never commit .env).
# GMAIL_APP_PASSWORD is a Google "App password", not your normal Gmail password:
#   Google Account > Security > 2-Step Verification (turn on) > App passwords > create one.
GMAIL_USER=punay.jeric@gmail.com
GMAIL_APP_PASSWORD=
